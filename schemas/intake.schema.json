{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neverlost://schemas/intake.schema.json",
  "title": "Neverlost Bounded Intake",
  "type": "object",
  "required": ["case_id", "synthetic_only", "person", "audience", "real_question", "requested_action", "authorized_source_ids", "exclusions"],
  "properties": {
    "case_id": {"type": "string"},
    "synthetic_only": {"const": true},
    "person": {
      "type": "object",
      "required": ["display_name", "life_direction"],
      "properties": {
        "display_name": {"type": "string"},
        "life_direction": {"type": "string"}
      }
    },
    "audience": {"type": "string"},
    "real_question": {"type": "string"},
    "requested_action": {"type": "string"},
    "authorized_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
